#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if ! git diff --quiet; then
    echo "Takt: stage all tracked changes; partial staging is unsupported." >&2
    exit 1
fi
if test -n "$(git ls-files --others --exclude-standard)"; then
    echo "Takt: stage or ignore all untracked files before committing." >&2
    exit 1
fi
git diff --cached --check
cmake -P scripts/quality.cmake
