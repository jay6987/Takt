include_guard(GLOBAL)

function(check_source_size path)
    file(READ "${path}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(REGEX REPLACE "[^\n]" "" newlines "${content}")
    string(LENGTH "${newlines}" lines)
    if(NOT content STREQUAL "" AND NOT content MATCHES "\n$")
        math(EXPR lines "${lines} + 1")
    endif()
    if(lines GREATER 400)
        message(FATAL_ERROR "${path}: ${lines} physical lines exceeds 400")
    endif()
endfunction()

function(check_coverage path)
    file(READ "${path}" report)
    string(JSON count LENGTH "${report}" data 0 files)
    if(count EQUAL 0)
        message(FATAL_ERROR "Coverage report contains no production files")
    endif()
    set(line_count 0)
    set(line_covered 0)
    set(branch_count 0)
    set(branch_covered 0)
    set(reported_files)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON filename GET "${report}" data 0 files ${index} filename)
        list(APPEND reported_files "${filename}")
        foreach(metric IN ITEMS lines branches)
            string(JSON total GET "${report}" data 0 files ${index} summary ${metric} count)
            string(JSON covered GET "${report}" data 0 files ${index} summary ${metric} covered)
            if(total LESS 0 OR covered LESS 0 OR covered GREATER total)
                message(FATAL_ERROR "Invalid coverage counts for ${filename}: ${metric}")
            endif()
            if(metric STREQUAL "lines")
                math(EXPR line_count "${line_count} + ${total}")
                math(EXPR line_covered "${line_covered} + ${covered}")
            else()
                math(EXPR branch_count "${branch_count} + ${total}")
                math(EXPR branch_covered "${branch_covered} + ${covered}")
            endif()
        endforeach()
    endforeach()
    foreach(expected IN LISTS ARGN)
        if(expected MATCHES "\\.cpp$" AND NOT expected IN_LIST reported_files)
            message(FATAL_ERROR "Production source missing from coverage: ${expected}")
        endif()
    endforeach()
    if(line_count EQUAL 0)
        message(FATAL_ERROR "Coverage has no executable production lines")
    endif()
    math(EXPR line_score "${line_covered} * 100")
    math(EXPR line_minimum "${line_count} * 80")
    math(EXPR branch_score "${branch_covered} * 100")
    math(EXPR branch_minimum "${branch_count} * 80")
    message(STATUS "Coverage: lines ${line_covered}/${line_count}; branches ${branch_covered}/${branch_count}")
    if(line_score LESS line_minimum OR branch_score LESS branch_minimum)
        message(FATAL_ERROR "Coverage below required 80% lines / 80% branches")
    endif()
endfunction()
